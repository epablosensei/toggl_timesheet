# Directory where to look for and write the data
DATA_DIR = 'data'

# Toggl API Token
API_TOKEN = 'ADD YOUR API TOKEN HERE'

# Workspace ID
WORKSPACE_ID = 'ADD YOUR WORKSPACE_ID HERE'

# Timezone
TIMEZONE = '+02:00'

# Align time — snaps both start and stop times to clean boundaries; duration is recalculated from those times.
# ALIGN_TIME = 15  -> :00 :15 :30 :45
# ALIGN_TIME = 30  -> :00 :30
# ALIGN_TIME = 1   -> :00 (hourly)
# ALIGN_TIME = 0   -> off
ALIGN_TIME = 15

# Roundup — rounds the duration up to the next interval, extending stop time forward; start is unchanged.
# Only has an effect when ALIGN_TIME = 0. When ALIGN_TIME and ROUNDUP are the same value, ROUNDUP is redundant.
# ROUNDUP = 15  -> next 15-min interval; ROUNDUP = 30  -> next 30-min; ROUNDUP = 1  -> next minute; 0 -> off
ROUNDUP = 0



